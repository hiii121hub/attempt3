<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <radialGradient id="bg" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#1c1c20"/>
      <stop offset="60%" stop-color="#0a0a0d"/>
      <stop offset="100%" stop-color="#000000"/>
    </radialGradient>
    <linearGradient id="silver" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="30%" stop-color="#b0b5bc"/>
      <stop offset="50%" stop-color="#ffffff"/>
      <stop offset="70%" stop-color="#70757d"/>
      <stop offset="100%" stop-color="#e2e8f0"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <circle cx="250" cy="250" r="235" fill="url(#bg)" stroke="#222" stroke-width="4"/>

  <!-- Browser Frame -->
  <rect x="120" y="90" width="260" height="240" rx="24" fill="#09090b" stroke="url(#silver)" stroke-width="6" filter="url(#glow)"/>
  <line x1="120" y1="135" x2="380" y2="135" stroke="url(#silver)" stroke-width="3"/>

  <!-- Dots -->
  <circle cx="148" cy="112" r="6" fill="url(#silver)"/>
  <circle cx="168" cy="112" r="6" fill="url(#silver)"/>
  <circle cx="188" cy="112" r="6" fill="url(#silver)"/>

  <!-- Circuit Lines -->
  <path d="M 140 210 L 170 210 L 185 225 M 140 240 L 160 240 M 360 210 L 330 210 L 315 225 M 360 240 L 340 240" stroke="url(#silver)" stroke-width="2" fill="none" opacity="0.8"/>
  <circle cx="185" cy="225" r="3" fill="url(#silver)"/>
  <circle cx="160" cy="240" r="3" fill="url(#silver)"/>
  <circle cx="315" cy="225" r="3" fill="url(#silver)"/>
  <circle cx="340" cy="240" r="3" fill="url(#silver)"/>

  <!-- Main Big X -->
  <path d="M 160 155 L 340 305 M 340 155 L 160 305" stroke="url(#silver)" stroke-width="28" stroke-linecap="round"/>
  <path d="M 160 155 L 340 305 M 340 155 L 160 305" stroke="#000000" stroke-width="10" stroke-linecap="round"/>

  <!-- Poxey X Text -->
  <text x="250" y="395" fill="url(#silver)" font-family="system-ui, -apple-system, sans-serif" font-size="46" font-weight="800" text-anchor="middle" letter-spacing="2">Poxey X</text>
</svg>